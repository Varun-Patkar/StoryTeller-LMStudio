---
import Layout from "../layouts/Layout.astro";
import { loadSettings } from "../lib/settings.js";
const s = await loadSettings();
---

<Layout title="Settings · StoryTeller Engine">
  <h1>Settings</h1>
  <p class="sub">Point the engine at your LM Studio server. Models load on demand when you generate — no manual loading.</p>

  <div class="card">
    <h2>LM Studio connection</h2>
    <div class="split">
      <div>
        <label for="baseUrl">Base URL</label>
        <input id="baseUrl" value={s.baseUrl} placeholder="http://localhost:1234" />
      </div>
      <div>
        <label for="apiKey">API key (optional)</label>
        <input id="apiKey" value={s.apiKey} type="password" placeholder="leave blank if none" />
      </div>
    </div>
    <div class="split">
      <div>
        <label for="mode">Generation mode</label>
        <select id="mode">
          <option value="completions" selected={s.mode === "completions"}>Completions — purest style mimicry (recommended)</option>
          <option value="chat" selected={s.mode === "chat"}>Chat — fallback</option>
        </select>
      </div>
      <div>
        <label for="model">Default model</label>
        <select id="model"><option value={s.model} selected>{s.model || "— pick after refreshing —"}</option></select>
      </div>
    </div>
    <div class="split">
      <div>
        <label for="temperature">Temperature</label>
        <input id="temperature" type="number" step="0.05" value={s.temperature} />
      </div>
      <div>
        <label for="maxTokens">Max tokens</label>
        <input id="maxTokens" type="number" step="128" value={s.maxTokens} />
      </div>
    </div>
    <div class="row" style="margin-top:14px">
      <button class="btn" id="save">Save</button>
      <button class="btn ghost" id="refresh">Refresh models</button>
    </div>
  </div>

  <div class="card">
    <h2>Models</h2>
    <p class="note">Downloaded models in LM Studio. Set a context length per model (blank = LM Studio default).
      The chosen model for each generation is loaded automatically at that time — no load buttons.</p>
    <div id="models"><p class="note">Save the connection, then Refresh models.</p></div>
  </div>

  <div class="toast" id="toast"></div>
</Layout>

<script define:vars={{ initial: s }}>
  const $ = (id) => document.getElementById(id);
  const toast = (msg, err = false) => {
    const t = $("toast"); t.textContent = msg; t.className = "toast show" + (err ? " err" : "");
    setTimeout(() => (t.className = "toast"), 2600);
  };

  // Per-model context lengths, kept in sync with the inputs below.
  const contextLengths = { ...(initial.contextLengths || {}) };

  function collect() {
    // Read the latest context-length inputs into the map.
    document.querySelectorAll("[data-ctx]").forEach((inp) => {
      const key = inp.dataset.ctx;
      const val = parseInt(inp.value, 10);
      if (Number.isFinite(val) && val > 0) contextLengths[key] = val;
      else delete contextLengths[key];
    });
    return {
      baseUrl: $("baseUrl").value.trim(),
      apiKey: $("apiKey").value,
      mode: $("mode").value,
      model: $("model").value.trim(),
      temperature: parseFloat($("temperature").value),
      maxTokens: parseInt($("maxTokens").value, 10),
      contextLengths,
    };
  }

  async function save() {
    const res = await fetch("/api/settings", {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(collect()),
    });
    if (!res.ok) return toast("Save failed.", true);
    toast("Saved.");
  }

  async function refresh() {
    const box = $("models");
    box.innerHTML = '<p class="note spin">Loading…</p>';
    const res = await fetch("/api/models");
    const data = await res.json();
    if (!res.ok) { box.innerHTML = `<p class="warn">${data.error}</p>`; return; }
    if (!data.models.length) { box.innerHTML = '<p class="note">No models found.</p>'; return; }

    // Rebuild the default-model dropdown from the live list.
    const sel = $("model");
    const current = sel.value || initial.model;
    sel.innerHTML = "";
    for (const m of data.models) {
      const opt = document.createElement("option");
      opt.value = m.key;
      opt.textContent = m.displayName;
      if (m.key === current) opt.selected = true;
      sel.appendChild(opt);
    }

    // Model list: context length only.
    box.innerHTML = "";
    for (const m of data.models) {
      const row = document.createElement("div");
      row.className = "row";
      row.style.justifyContent = "space-between";
      row.style.alignItems = "center";
      row.style.borderTop = "1px solid var(--line)";
      row.style.padding = "12px 0";
      const ctx = contextLengths[m.key] ?? "";
      row.innerHTML = `
        <div><div>${m.displayName}</div><div class="mono">${m.key}</div></div>
        <div class="row" style="align-items:center">
          <span class="pill ${m.loaded ? "on" : ""}">${m.loaded ? "loaded" : "idle"}</span>
          <label class="mono" style="margin:0">Context</label>
          <input data-ctx="${m.key}" type="number" step="1024" min="0" value="${ctx}" placeholder="default" style="width:130px" />
        </div>`;
      box.appendChild(row);
    }
  }

  $("save").addEventListener("click", save);
  $("refresh").addEventListener("click", refresh);

  // Load the model list on first paint so the dropdown + context inputs are ready.
  refresh();
</script>
