---
import Layout from "../layouts/Layout.astro";
import {
  ensureGlobalPrompts,
  readGlobalPrompt,
  listGlobalSamples,
  globalPromptLint,
} from "../lib/books.js";

// Make sure the global prompt files exist (fresh clone / first run).
await ensureGlobalPrompts();

const promptFiles = [
  { rel: "system.md", label: "System prompt", note: "AI placeholder — replace it, or leave empty to send no system framing." },
  { rel: "plan-prompt.md", label: "Plan prompt", note: "Your instruction for generating a book's plan." },
  { rel: "plan-rewrite-prompt.md", label: "Plan-rewrite prompt", note: "Your instruction for revising the plan from a note." },
  { rel: "chapter-prompt.md", label: "Chapter prompt", note: "Your instruction for writing a chapter." },
  { rel: "rewrite-prompt.md", label: "Rewrite prompt", note: "Your instruction for revising text from a note." },
];
for (const p of promptFiles) p.content = await readGlobalPrompt(p.rel);

const sampleFiles = await listGlobalSamples();
const lint = await globalPromptLint();
---

<Layout title="Prompts · StoryTeller Engine">
  <h1>Prompts</h1>
  <p class="sub">Author-level prompts, shared by every book. Stored in the repo-root <span class="mono">prompts/</span> folder.</p>

  {lint.length > 0 && (
    <div class="warn"><strong>Still AI drafts:</strong> {lint.map((f) => <code>{f} </code>)} — rewrite in your own words and remove the marker.</div>
  )}

  {promptFiles.map((p) => (
    <div class="card">
      <h2>{p.label} <span class="mono note">— prompts/{p.rel}</span></h2>
      <p class="note">{p.note}</p>
      <textarea data-file={p.rel} style="min-height:180px" set:text={p.content}></textarea>
      <div class="row" style="margin-top:10px"><button class="btn" data-save={p.rel}>Save</button></div>
    </div>
  ))}

  <div class="card">
    <h2>Writing samples <span class="mono note">— prompts/samples/</span></h2>
    <p class="note">Your reference prose. This teaches the model your voice more than any instruction. Add a few passages you wrote yourself.</p>
    <div id="samples">
      {sampleFiles.length === 0 && <p class="note">No samples yet.</p>}
      {sampleFiles.map((f) => (
        <div class="row" style="justify-content:space-between;border-top:1px solid var(--line);padding:8px 0">
          <a href="#" data-open={`samples/${f}`}>{f}</a>
          <button class="btn danger" data-del={`samples/${f}`}>✕</button>
        </div>
      ))}
    </div>
    <div class="row" style="margin-top:10px"><button class="btn ghost" id="add-sample">+ add sample</button></div>

    <div id="sample-editor" style="display:none;margin-top:14px">
      <label id="sample-path"></label>
      <textarea id="sample-text" style="min-height:220px"></textarea>
      <div class="row" style="margin-top:10px"><button class="btn" id="sample-save">Save sample</button></div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</Layout>

<script>
  const $ = (id) => document.getElementById(id);
  const toast = (m, e = false) => { const t = $("toast"); t.textContent = m; t.className = "toast show" + (e ? " err" : ""); setTimeout(() => (t.className = "toast"), 2200); };
  const put = (rel, content) => fetch("/api/prompt", { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ rel, content }) });

  document.querySelectorAll("[data-save]").forEach((b) => b.addEventListener("click", async () => {
    const rel = b.dataset.save;
    const ta = document.querySelector(`textarea[data-file="${rel}"]`);
    const res = await put(rel, ta.value);
    toast(res.ok ? "Saved." : "Save failed.", !res.ok);
  }));

  // samples
  let sampleRel = null;
  async function openSample(rel) {
    const res = await fetch(`/api/prompt?rel=${encodeURIComponent(rel)}`);
    const data = await res.json();
    sampleRel = rel;
    $("sample-editor").style.display = "block";
    $("sample-path").textContent = "prompts/" + rel;
    $("sample-text").value = data.content;
  }
  document.querySelectorAll("[data-open]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); openSample(a.dataset.open); }));
  document.querySelectorAll("[data-del]").forEach((b) => b.addEventListener("click", async () => {
    if (!confirm(`Delete prompts/${b.dataset.del}?`)) return;
    const res = await fetch("/api/prompt", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ rel: b.dataset.del }) });
    if (res.ok) location.reload(); else toast("Delete failed.", true);
  }));
  $("add-sample").addEventListener("click", async () => {
    const name = prompt("New sample — file name (without .md):");
    if (!name) return;
    const clean = name.toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "");
    if (!clean) return toast("Invalid name.", true);
    const res = await put(`samples/${clean}.md`, "");
    if (res.ok) location.reload(); else toast("Create failed.", true);
  });
  $("sample-save").addEventListener("click", async () => {
    if (!sampleRel) return;
    const res = await put(sampleRel, $("sample-text").value);
    toast(res.ok ? "Saved." : "Save failed.", !res.ok);
  });
</script>
