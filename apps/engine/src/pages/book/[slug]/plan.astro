---
import Layout from "../../../layouts/Layout.astro";
import BookTabs from "../../../components/BookTabs.astro";
import { getBook, readBookFile } from "../../../lib/books.js";
import { loadSettings } from "../../../lib/settings.js";

const { slug } = Astro.params;
const book = await getBook(slug);
if (!book) return Astro.redirect("/");
const plan = await readBookFile(slug, "plan.md");
const settings = await loadSettings();
---

<Layout title={`Plan · ${book.title}`}>
  <h1>{book.title}</h1>
  <p class="sub mono">{book.slug}</p>
  <BookTabs slug={slug} active="plan" />

  <div class="card">
    <h2>plan.md</h2>
    <p class="note">A <em>living</em> plan — premise, a loose overarching direction, and detailed
      beats only for what you know so far (e.g. the first arc). It grows as you write; you don't
      have to outline the whole book. Generate it, edit freely, or rewrite parts below. The whole
      plan is used as context when writing each chapter.</p>
    <div class="row" style="margin-bottom:10px">
      <label for="model" class="mono" style="margin:0">Model</label>
      <select id="model" style="width:auto;min-width:220px"></select>
      <button class="btn" id="gen">Generate plan</button>
      <button class="btn ghost" id="save">Save</button>
      <span class="note" id="status"></span>
      <span id="gauge" class="token-gauge"></span>
    </div>
    <textarea id="editor" style="min-height:480px" set:text={plan}></textarea>
  </div>

  <div class="card">
    <h2>Rewrite by comment</h2>
    <p class="note">Select part of the plan above (or select nothing to rewrite the whole plan),
      leave a note describing the change, and the model revises it — guided by <em>your</em>
      plan-rewrite-prompt. Nothing is applied until you accept it.</p>
    <div id="sel-info" class="note mono">Nothing selected — the whole plan will be rewritten.</div>
    <label for="comment">Your note</label>
    <textarea id="comment" style="min-height:80px" placeholder="e.g. merge chapters 3 and 4, push the betrayal to the midpoint"></textarea>
    <div class="row" style="margin-top:10px">
      <button class="btn" id="rewrite">Rewrite plan</button>
      <span class="note" id="rw-status"></span>
    </div>

    <div id="result" style="display:none;margin-top:14px">
      <label>Proposed revision</label>
      <textarea id="result-text" style="min-height:220px"></textarea>
      <div class="row" style="margin-top:10px">
        <button class="btn" id="apply">Apply</button>
        <button class="btn ghost" id="discard">Discard</button>
      </div>
    </div>
  </div>
  <div class="toast" id="toast"></div>
</Layout>

<script is:inline src="/model-picker.js"></script>
<script is:inline src="/token-gauge.js"></script>
<script define:vars={{ slug, defaultModel: settings.model }}>
  const $ = (id) => document.getElementById(id);
  const toast = (m, e = false) => { const t = $("toast"); t.textContent = m; t.className = "toast show" + (e ? " err" : ""); setTimeout(() => (t.className = "toast"), 2600); };

  // Populate the model dropdown (defaults to the saved model).
  window.initModelPicker?.($("model"), defaultModel);

  const editor = $("editor");

  // Track selection within the plan editor (for partial rewrites).
  let sel = { start: 0, end: 0 };
  function updateSel() {
    sel = { start: editor.selectionStart, end: editor.selectionEnd };
    const has = sel.end > sel.start;
    $("sel-info").textContent = has
      ? `Selected ${sel.end - sel.start} characters — only that span will be rewritten.`
      : "Nothing selected — the whole plan will be rewritten.";
  }
  editor.addEventListener("select", updateSel);
  editor.addEventListener("keyup", updateSel);
  editor.addEventListener("mouseup", updateSel);

  $("gen").addEventListener("click", async () => {
    $("status").textContent = "Generating from your prompts…";
    $("gen").disabled = true;
    try {
      const res = await fetch("/api/generate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ slug, task: "plan", model: $("model").value }) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed.");
      $("editor").value = data.text;
      window.renderTokenGauge?.($("gauge"), data.usage?.peakTotal, data.contextMax);
      $("status").textContent = "Draft in editor — review, edit, then Save.";
    } catch (err) {
      $("status").textContent = "";
      toast(err.message, true);
    } finally {
      $("gen").disabled = false;
    }
  });

  $("save").addEventListener("click", async () => {
    const res = await fetch("/api/file", { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ slug, rel: "plan.md", content: $("editor").value }) });
    toast(res.ok ? "Saved." : "Save failed.", !res.ok);
  });

  $("rewrite").addEventListener("click", async () => {
    const comment = $("comment").value.trim();
    if (!comment) return toast("Leave a note first.", true);
    const selection = sel.end > sel.start ? editor.value.slice(sel.start, sel.end) : "";
    $("rw-status").textContent = "Revising…";
    $("rewrite").disabled = true;
    try {
      const res = await fetch("/api/generate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ slug, task: "plan-rewrite", fullText: editor.value, selection, comment, model: $("model").value }) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed.");
      $("result-text").value = data.text.trim();
      window.renderTokenGauge?.($("gauge"), data.usage?.peakTotal, data.contextMax);
      $("result").style.display = "block";
      $("rw-status").textContent = "";
    } catch (err) { $("rw-status").textContent = ""; toast(err.message, true); }
    finally { $("rewrite").disabled = false; }
  });

  $("apply").addEventListener("click", () => {
    const revised = $("result-text").value;
    if (sel.end > sel.start) {
      editor.value = editor.value.slice(0, sel.start) + revised + editor.value.slice(sel.end);
    } else {
      editor.value = revised;
    }
    $("result").style.display = "none";
    $("comment").value = "";
    updateSel();
    toast("Applied. Remember to Save.");
  });
  $("discard").addEventListener("click", () => { $("result").style.display = "none"; });
</script>
