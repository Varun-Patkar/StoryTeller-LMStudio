---
const { slug, active } = Astro.props;
const tabs = [
  { id: "overview", label: "Overview", href: `/book/${slug}` },
  { id: "config", label: "Config", href: `/book/${slug}/config` },
  { id: "canon", label: "Canon", href: `/book/${slug}/canon` },
  { id: "memory", label: "Memory", href: `/book/${slug}/memory` },
  { id: "plan", label: "Plan", href: `/book/${slug}/plan` },
];
---
<div class="tabs">
  {tabs.map((t) => (
    <a href={t.href} class={t.id === active ? "active" : ""}>{t.label}</a>
  ))}
</div>
