---
// Reader layout: neutral/amber chrome with a light/dark theme toggle.
// `bodyClass` lets pages opt into the immersive reading surface (adds `reading`).
const { title = "StoryTeller", bodyClass = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p}`.replace(/([^:]\/)\/+/g, "$1");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <link rel="stylesheet" href={href("reader.css")} />
    <!-- Restore chrome + reader theme before paint to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("st-theme");
          var rs = JSON.parse(
            localStorage.getItem("st-reader-settings") || "{}"
          );
          var rt = rs.readerTheme;
          if (rt) document.documentElement.setAttribute("data-reader-theme", rt);
          var wantsDark =
            t === "dark" ||
            (!t &&
              window.matchMedia &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          if (wantsDark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <header class="rtop">
      <a class="rbrand" href={href("")}>
        <span>📖</span> StoryTeller
      </a>
      <div class="ractions">
        <slot name="header-actions" />
        <a
          class="icon-btn"
          href="https://github.com/Varun-Patkar/StoryTeller-LMStudio"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View source on GitHub"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"></path>
          </svg>
        </a>
        <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle light/dark theme">
          <!-- Sun (shown in dark mode) -->
          <svg class="theme-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <!-- Moon (shown in light mode) -->
          <svg class="theme-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </header>
    <slot />

    <script is:inline>
      // Light/dark chrome toggle (library + TOC). On the reading surface the
      // theme is driven by the reader-theme setting instead.
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("st-theme", isDark ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>
