---
const { title = "StoryTeller" } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p}`.replace(/([^:]\/)\/+/g, "$1");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={href("reader.css")} />
  </head>
  <body>
    <header class="rtop">
      <a class="rbrand" href={href("")}>StoryTeller</a>
    </header>
    <slot />
  </body>
</html>
