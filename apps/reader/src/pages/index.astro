---
import Reader from "../layouts/Reader.astro";
import { getBooks } from "../lib/books.js";
const books = getBooks();
const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p}`.replace(/([^:]\/)\/+/g, "$1");
---

<Reader title="StoryTeller">
  <div class="container">
    <h1>Library</h1>
    <p class="muted">Stories written locally, published to read anywhere.</p>
    <ul class="booklist">
      {books.map((b) => (
        <li>
          <a href={href(b.slug)}>
            <h2>{b.title}</h2>
          </a>
          <div class="tags">
            {b.chapters.length} chapter{b.chapters.length === 1 ? "" : "s"}
            {Array.isArray(b.genre) && b.genre.length ? ` · ${b.genre.join(", ")}` : ""}
          </div>
        </li>
      ))}
      {books.length === 0 && <li class="muted">No published stories yet.</li>}
    </ul>
  </div>
</Reader>
