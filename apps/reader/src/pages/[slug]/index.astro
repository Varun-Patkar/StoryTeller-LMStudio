---
import Reader from "../../layouts/Reader.astro";
import { getBooks, getBookMeta, getChapters } from "../../lib/books.js";

export function getStaticPaths() {
  return getBooks().map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const meta = getBookMeta(slug);
const chapters = getChapters(slug);
const base = import.meta.env.BASE_URL;
const href = (p) => `${base}${p}`.replace(/([^:]\/)\/+/g, "$1");
---

<Reader title={meta.title}>
  <div class="container">
    <div class="crumbs"><a href={href("")}>Library</a> / {meta.title}</div>
    <h1>{meta.title}</h1>
    {meta.setting && <p class="muted">{meta.setting}</p>}
    <ol class="toc">
      {chapters.map((c) => (
        <li>
          <a href={href(`${slug}/${c.number}`)}>
            <span>{c.title}</span>
            <span class="n">{c.number}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Reader>
